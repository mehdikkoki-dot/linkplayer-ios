<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Replace the three placeholders below before running the workflow:
	     TEAMID = your Apple Developer Team ID (10 characters)
	     com.example.linkplayer = the bundle ID of your provisioning profile
	     PROFILE_NAME = the provisioning profile's name as shown in Xcode /
	     Apple Developer (or its UUID). If your certificate is a DEVELOPMENT
	     certificate (not distribution), change method to "development" and
	     CODE_SIGN_IDENTITY in ios.yml to "Apple Development". -->
	<key>method</key>
	<string>ad-hoc</string>
	<key>teamID</key>
	<string>TEAMID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.example.linkplayer</key>
		<string>PROFILE_NAME</string>
	</dict>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
