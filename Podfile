# CocoaPods integration for MobileVLCKit (the iOS build of VLC).
# CocoaPods is the integration method recommended by VideoLAN.
# IMPORTANT: change 'LinkPlayer' below to your Xcode project's target name
# if you named the project differently, then run `pod install` in this
# folder and always open the generated .xcworkspace (not .xcodeproj).

platform :ios, '14.0'

target 'LinkPlayer' do
  use_frameworks!
  pod 'MobileVLCKit', '~> 3.6'
end
